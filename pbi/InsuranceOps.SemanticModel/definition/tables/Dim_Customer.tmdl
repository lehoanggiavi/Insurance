		summarizeBy: sum
		sourceColumn: _source_row

		annotation SummarizationSetBy = Automatic

	partition Dim_Customer = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(#"Data Folder" & "\customers_curated.csv"), [Delimiter = ",", Columns = 12, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    RongThanhNull = Table.ReplaceValue(PromotedHeaders, "", null, Replacer.ReplaceValue, {"RegionID", "BirthDate__iso", "_source_row"}),
				    Typed = Table.TransformColumnTypes(RongThanhNull, {
				        {"CustomerID", Int64.Type},
					        {"CustomerID__source", type text},
					        {"Gender", type text},
					        {"ParticipantType", type text},
					        {"RegionID", Int64.Type},
					        {"MaritalStatus", type text},
					        {"BirthDate__iso", type date},
					        {"BirthYear", type text},
					        {"BirthDate__source_is_datetime", type logical},
					        {"birthdate_null_flag", type logical},
					        {"quality_flags", type text},
					        {"_source_row", Int64.Type}
				    }, "en-US"),
				    Sorted = Table.Sort(Typed, {"CustomerID", Order.Ascending})
				in
				    Sorted

