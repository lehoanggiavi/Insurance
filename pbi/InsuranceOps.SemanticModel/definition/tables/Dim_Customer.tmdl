/// Dimension khách hàng. Grain = 1 dòng / 1 CustomerID. Không có FirstName/LastName (projection; không cần cho tính chỉ số).
table Dim_Customer
	lineageTag: 3041e7ca-2043-4559-81db-2cddcdce01a0

	column CustomerID
		dataType: int64
		isKey
		formatString: #,0
		lineageTag: 367f2c2a-3159-46e5-8cab-b3ae709e0530
		summarizeBy: none
		sourceColumn: CustomerID

	column CustomerID__source
		dataType: string
		isHidden
		lineageTag: e8a561b6-d6b3-4a27-b932-37caf47c53ea
		summarizeBy: none
		sourceColumn: CustomerID__source

	column Gender
		dataType: string
		lineageTag: 373899f3-8a03-4b01-9c44-553b3e6b8350
