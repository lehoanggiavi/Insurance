		lineageTag: 796a6ce8-2fde-4c8d-bf2e-1ab2a6fad441
		summarizeBy: none
		sourceColumn: BirthDate__iso

		variation Variation
			isDefault
			relationship: 6546f24c-f9c5-4af9-af28-dfe002568bb7
			defaultHierarchy: LocalDateTable_a888673f-e8f9-4cef-8d63-eb7c13fc6d57.'Phân cấp ngày tháng'

		annotation UnderlyingDateTimeDataType = Date

	column BirthYear
		dataType: string
