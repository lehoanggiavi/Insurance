/// Bang fact khiếu nại. Grain = 1 dòng / 1 ComplaintID. Nguyên bản từ complaints_curated.csv.
table Fact_Complaint
	lineageTag: e7bbad50-b25a-4ced-b2f4-3cd16a5b49af

	column ComplaintID
