	partition Fact_Complaint = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(#"Data Folder" & "\complaints_curated.csv"), [Delimiter = ",", Columns = 25, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    RongThanhNull = Table.ReplaceValue(PromotedHeaders, "", null, Replacer.ReplaceValue, {"ComplaintID__int", "ComplainDate__iso", "CompletionDate__iso", "CustomerID", "BrokerID", "ProductID", "ComplainPriorityID", "ComplainTypeID", "ComplainSourceID", "ComplainCategoryID", "ComplainStatusID", "AdministratorID", "ExpectedReimbursement", "processing_days", "age_at_complaint", "_source_row"}),
				    Typed = Table.TransformColumnTypes(RongThanhNull, {
				        {"ComplaintID", Int64.Type},
					        {"ComplaintID__source", type text},
					        {"ComplaintID__int", Int64.Type},
					        {"ComplainDate__iso", type date},
					        {"CompletionDate__iso", type date},
					        {"CompletionDate__source_kind", type text},
					        {"CustomerID", Int64.Type},
					        {"BrokerID", Int64.Type},
					        {"ProductID", Int64.Type},
					        {"ComplainPriorityID", Int64.Type},
					        {"ComplainTypeID", Int64.Type},
					        {"ComplainSourceID", Int64.Type},
					        {"ComplainCategoryID", Int64.Type},
					        {"ComplainStatusID", Int64.Type},
					        {"ComplainStatus", type text},
					        {"AdministratorID", Int64.Type},
					        {"ClientSatisfaction", type text},
					        {"ExpectedReimbursement", type number},
					        {"processing_days", Int64.Type},
					        {"age_at_complaint", Int64.Type},
					        {"age_bucket", type text},
					        {"completion_null_flag", type logical},
					        {"category_inactive_flag", type logical},
					        {"quality_flags", type text},
					        {"_source_row", Int64.Type}
				    }, "en-US"),
				    Sorted = Table.Sort(Typed, {"ComplaintID", Order.Ascending})
				in
				    Sorted

