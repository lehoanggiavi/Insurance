/// Dimension nguồn khiếu nại.
table Dim_Source
	lineageTag: a566e373-1c02-45fd-a127-ad4244f8c539

	column ID
		dataType: int64
		isKey
		formatString: #,0
		lineageTag: 77fe2280-73c3-469d-8901-76f9ca0db41f
		summarizeBy: none
		sourceColumn: ID

	column ID__source
		dataType: string
		isHidden
		lineageTag: 379101b8-f9ff-4c2b-8a8b-00596b67cbda
		summarizeBy: none
		sourceColumn: ID__source

	column ID__int
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: dc998f54-8433-46c2-b04f-094cb425ac7f
		summarizeBy: none
		sourceColumn: ID__int

	column Description
		dataType: string
		lineageTag: fa6a53e0-986e-4647-8a5b-0f5a22023bdc
		summarizeBy: none
		sourceColumn: Description

	partition Dim_Source = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(#"Data Folder" & "\sources_curated.csv"), [Delimiter = ",", Columns = 4, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    RongThanhNull = Table.ReplaceValue(PromotedHeaders, "", null, Replacer.ReplaceValue, {"ID__int"}),
				    Typed = Table.TransformColumnTypes(RongThanhNull, {
				        {"ID", Int64.Type},
					        {"ID__source", type text},
					        {"ID__int", Int64.Type},
					        {"Description", type text}
				    }, "en-US"),
				    Sorted = Table.Sort(Typed, {"ID", Order.Ascending})
				in
				    Sorted

