/// Dimension nhóm khiếu nại. Active=0 vẫn giữ đủ, chỉ gắn cờ.
table Dim_Category
	lineageTag: 68184c27-da21-460d-8296-ce9b06320c8a

	column ID
		dataType: int64
		isKey
		formatString: #,0
		lineageTag: b70639c2-8c2a-42f6-8c08-2291f11bef7b
		summarizeBy: none
		sourceColumn: ID

	column ID__source
		dataType: string
		isHidden
		lineageTag: 637726e2-a4e7-4be2-a1b6-e7a3a0890b8c
		summarizeBy: none
		sourceColumn: ID__source

	column ID__int
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: 6bc52f0c-6575-47c6-8cce-9078cc93fc5b
		summarizeBy: none
		sourceColumn: ID__int

	column Description
		dataType: string
		lineageTag: 58aee402-3920-4cc8-8364-d52919eb2301
		summarizeBy: none
		sourceColumn: Description

	column Active
		dataType: double
		formatString: #,0.00
		lineageTag: 051045e8-8ad0-4f69-aed8-3c7771bd4637
		summarizeBy: none
		sourceColumn: Active

	column Active__int
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: d480e9cc-8a9a-411f-84e7-550fff63254c
		summarizeBy: none
		sourceColumn: Active__int

	partition Dim_Category = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(#"Data Folder" & "\categories_curated.csv"), [Delimiter = ",", Columns = 6, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    RongThanhNull = Table.ReplaceValue(PromotedHeaders, "", null, Replacer.ReplaceValue, {"ID__int", "Active", "Active__int"}),
				    Typed = Table.TransformColumnTypes(RongThanhNull, {
				        {"ID", Int64.Type},
					        {"ID__source", type text},
					        {"ID__int", Int64.Type},
					        {"Description", type text},
					        {"Active", type number},
					        {"Active__int", Int64.Type}
				    }, "en-US"),
				    Sorted = Table.Sort(Typed, {"ID", Order.Ascending})
				in
				    Sorted

