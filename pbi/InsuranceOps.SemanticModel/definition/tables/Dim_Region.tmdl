	partition Dim_Region = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(#"Data Folder" & "\regions_curated.csv"), [Delimiter = ",", Columns = 17, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    RongThanhNull = Table.ReplaceValue(PromotedHeaders, "", null, Replacer.ReplaceValue, {"id__int", "latitude", "longitude", "population", "households", "median_income", "land_area", "water_area"}),
				    Typed = Table.TransformColumnTypes(RongThanhNull, {
				        {"id", Int64.Type},
					        {"id__source", type text},
					        {"id__int", Int64.Type},
					        {"name", type text},
					        {"county", type text},
					        {"state_code", type text},
					        {"state", type text},
					        {"type", type text},
					        {"latitude", type number},
					        {"longitude", type number},
					        {"area_code", type text},
					        {"population", Int64.Type},
					        {"households", Int64.Type},
					        {"median_income", type number},
					        {"land_area", type number},
					        {"water_area", type number},
					        {"time_zone", type text}
				    }, "en-US"),
				    Sorted = Table.Sort(Typed, {"id", Order.Ascending})
				in
				    Sorted

