/// Dimension vùng. Grain = 1 dòng / 1 id. Tọa độ chuyển sang double ở đây (nguồn là chuỗi, cần kiểm kiểu trước khi dùng tính khoảng cách).
table Dim_Region
	lineageTag: 4c2399c9-ec2f-48dd-8a9d-f8f9e3563be9

	column id
		dataType: int64
		isKey
		formatString: #,0
		lineageTag: 77969797-16ce-49e6-ae4c-a3dc9c8ea29b
		summarizeBy: none
